{
  "expo": {
    "name": "Sentinela",
    "slug": "sentinela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14142B"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#14142B",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#14142B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sentinela.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAauiNB51SJ4QdfHGGoTB87sJZ-DVsozjk"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#14142B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "READ_CONTACTS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "O Sentinela necessita de aceder aos seus contactos para selecionar os números de emergência para onde enviar SMS e WhatsApp em caso de SOS."
        }
      ]
    ]
  }
}
